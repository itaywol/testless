---
import "../styles/global.css";

const repo = "https://github.com/itaywol/testless";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>testless: cut your test time to the minimum</title>
    <meta
      name="description"
      content="testless cuts your test time to the minimum: function-level test impact analysis via static AST picks exactly the tests your change could break. TypeScript/JavaScript, Go, and Rust."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="wrap">
          <img class="logo" src="/logo-dark.svg" alt="testless" width="259" height="95" />
          <h1 class="tagline">Cut your test time to the minimum.</h1>
          <p class="proof-line">Run 5 tests instead of 500.</p>
          <p class="subline">
            testless statically analyzes your code down to the function
            level and picks exactly the tests a change could break. It reads
            your code, not your coverage.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#install">Get started</a>
            <a class="btn btn-secondary" href={repo}>GitHub</a>
          </div>
        </div>
      </section>

      <section id="install">
        <div class="wrap">
          <p class="eyebrow">Install</p>
          <h2>Pick your ecosystem</h2>
          <p class="section-lede">
            testless ships a single Rust binary with native entry points for
            every ecosystem it supports. All three are equal citizens.
          </p>
          <div class="card-grid">
            <div class="card install-card">
              <h3>JS / TS</h3>
              <pre class="mono"><code>npm i -D testless-cli</code></pre>
            </div>
            <div class="card install-card">
              <h3>Go</h3>
              <pre class="mono"><code>curl -fsSL https://testless.itaywol.tools/install.sh | sh</code></pre>
            </div>
            <div class="card install-card">
              <h3>Rust</h3>
              <pre class="mono"><code>cargo binstall testless</code></pre>
            </div>
          </div>
          <p class="binaries-note">
            Prefer a prebuilt binary? Grab one from
            <a href={`${repo}/releases`}>the releases page</a>.
          </p>
        </div>
      </section>

      <section id="demo">
        <div class="wrap">
          <p class="eyebrow">Demo</p>
          <h2 id="demo-title">See it pick the tests</h2>
          <div class="demo-frame">
            <img
              id="demo-gif"
              src="/demo.gif"
              alt="Terminal recording of testless indexing a repository, then selecting the small set of tests impacted by a code change"
              width="1400"
              height="800"
            />
          </div>
          <div class="demo-caption">
            <p id="demo-context">testless indexes the repo into a graph of functions, tests, and imports.</p>
            <p>A changed function is diffed structurally, comments and formatting are free.</p>
            <p>The reverse impact walk prints only the tests that could break, ready to run.</p>
          </div>
          <p class="demo-scale">
            Scale checked on real repos: astro (6,121 tests, indexed in 3.1s),
            gin (677 tests, 0.3s), openclaw (106,594 tests across 22,797
            files, 86s).
          </p>
          <script is:inline>
            (function () {
              var demos = [
                {
                  src: "/demo.gif",
                  title: "See it pick the tests",
                  context:
                    "testless indexes the repo into a graph of functions, tests, and imports.",
                },
                {
                  src: "/demo-astro.gif",
                  title: "Live on withastro/astro: 6 of 6,121 tests",
                  context:
                    "A real astro commit (a Markdoc transform fix). testless selects 6 impacted tests out of 6,121.",
                },
                {
                  src: "/demo-gin.gif",
                  title: "Live on gin-gonic/gin: 18 of 674 tests",
                  context:
                    "A real gin commit (a panic-recovery fix). testless selects 18 impacted tests out of 674.",
                },
              ];
              var pick = demos[Math.floor(Math.random() * demos.length)];
              document.getElementById("demo-gif").src = pick.src;
              document.getElementById("demo-title").textContent = pick.title;
              document.getElementById("demo-context").textContent = pick.context;
            })();
          </script>
        </div>
      </section>

      <section id="how-it-works">
        <div class="wrap">
          <p class="eyebrow">How it works</p>
          <h2>Three steps, one guarantee</h2>
          <div class="card-grid">
            <div class="card">
              <span class="card-step">01</span>
              <h3>Parse</h3>
              <p>
                tree-sitter builds a graph of every function, test, and
                import across your codebase.
              </p>
            </div>
            <div class="card">
              <span class="card-step">02</span>
              <h3>Diff</h3>
              <p>
                A structural AST diff finds what actually changed.
                Comments and formatting are free.
              </p>
            </div>
            <div class="card">
              <span class="card-step">03</span>
              <h3>Walk</h3>
              <p>
                A reverse impact walk finds every test that can reach the
                change and prints your runner's own CLI invocation.
              </p>
            </div>
          </div>
          <p class="guarantee">
            Selection is always a superset of the truly impacted tests.
            testless widens instead of guessing, and never silently skips a
            test that could fail.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <span class="mono">MIT licensed</span>
        <nav class="footer-links">
          <a href={repo}>GitHub</a>
          <a href="https://crates.io/crates/testless">crates.io</a>
          <a href="https://www.npmjs.com/package/testless">npm</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
